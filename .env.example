# Cloudflare Credentials
CF_API_TOKEN=your_cloudflare_api_token_here
CF_ZONE_ID=your_cloudflare_zone_id_here

# Guardian Detection Parameters
# Interval in seconds to check traffic (e.g. 10)
CHECK_INTERVAL=10

# Request Per Second (RPS) threshold to ENABLE Under Attack Mode
ENABLE_THRESHOLD=1200

# Request Per Second (RPS) threshold to DISABLE Under Attack Mode
DISABLE_THRESHOLD=350

# Percentage of 5xx Errors before triggering UAM (e.g. 5 for 5%)
ERROR_RATE_THRESHOLD=5

# Enable Local CPU Monitoring (true/false)
LOCAL_MONITORING_ENABLED=true

# CPU Usage percentage threshold before triggering UAM (e.g. 90)
CPU_THRESHOLD=90

# Cooldown time in minutes before disabling UAM after traffic normalizes
COOLDOWN_MINUTES=5

# Default security level to restore when UAM is disabled (off, essentially_off, low, medium, high)
DEFAULT_SECURITY_LEVEL=medium

# Discord Webhook Notification (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# System Logging (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info